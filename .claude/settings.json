{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Ss]heets.*__.*",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sheets_guard.py\" pre", "timeout": 30 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*[Ss]heets.*__.*",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sheets_guard.py\" post", "timeout": 30 }]
      }
    ]
  }
}
